import 'package:flutter/material.dart';

void main() => runApp(FinFlowApp());

class FinFlowApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      theme: ThemeData.dark(), // Biznes uchun zamonaviy qora mavzu
      home: BusinessDashboard(),
    );
  }
}

class BusinessDashboard extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("FinFlow Business"), centerTitle: true),
      body: Padding(
        padding: EdgeInsets.all(16.0),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text("Umumiy Foyda", style: TextStyle(fontSize: 18, color: Colors.grey)),
            Text("13,000,000 UZS", style: TextStyle(fontSize: 32, fontWeight: FontWeight.bold, color: Colors.greenAccent)),
            SizedBox(height: 20),
            // Bu yerda grafik joylashadi
            Container(
              height: 200,
              width: double.infinity,
              decoration: BoxDecoration(
                color: Colors.white10,
                borderRadius: BorderRadius.circular(15),
              ),
              child: Center(child: Text("Haftalik Savdo Grafigi (AI tahlili)")),
            ),
            SizedBox(height: 20),
            Text("AI Tavsiyasi:", style: TextStyle(fontWeight: FontWeight.bold)),
            Card(Navigator.push(context, MaterialPageRoute(builder: (context) => AIChatScreen
              color: Colors.blueGrey[900],
              child: ListTile(
                leading: Icon(Icons.psychology, color: Colors.purpleAccent),
                title: Text("Reklamaga sarfni 5% oshiring, bu savdoni 12% ga ko'taradi."),
              ),
            ),
          ],
        ),
      ),
    );
  }
}
// DashboardScreen ichida:
bool isLoading = true;
double balance = 0;
String aiMessage = "";

@override
void initState() {
  super.initState();
  _loadData();
}

_loadData() async {
  try {
    final data = await ApiService().fetchDashboard(1); // 1 - foydalanuvchi IDsi
    setState(() {
      balance = data['balance'];
      aiMessage = data['ai_analysis'];
      isLoading = false;
    });
  } catch (e) {
    print("Xato: $e");
  }
}
