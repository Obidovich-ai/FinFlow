                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text("Umumiy Balans", style: TextStyle(color: Colors.white.withOpacity(0.8), fontSize: 16)),
                    SizedBox(height: 8),
